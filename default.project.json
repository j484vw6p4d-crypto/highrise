{
  "name": "Highrise",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/ReplicatedStorage/Shared" },
      "Remotes": { "$className": "Folder" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Boot": { "$path": "src/ServerScriptService/Boot.server.lua" },
      "Services": { "$path": "src/ServerScriptService/Services" },
      "Main": { "$path": "src/ServerScriptService/Main.server.lua" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/StarterPlayer/StarterPlayerScripts/Client.client.lua" }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "HighriseGround": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "CastShadow": false,
          "Size": [1024, 32, 1024],
          "CFrame": [0, -16, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1],
          "Color": [0.047, 0.055, 0.078],
          "Material": "SmoothPlastic",
          "Locked": true
        }
      },
      "LobbySpawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Size": [16, 1, 16],
          "CFrame": [0, 1.5, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1],
          "Transparency": 1,
          "Duration": 10,
          "Neutral": true,
          "Locked": true
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true
    },
    "SoundService": { "$className": "SoundService" },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true
    }
  }
}
